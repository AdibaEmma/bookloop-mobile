{
  "expo": {
    "name": "BookLoop",
    "slug": "bookloop",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aweperi.bookloop",
      "infoPlist": {
        "NSCameraUsageDescription": "BookLoop needs access to your camera to scan ISBN barcodes on books."
      },
      "appleTeamId": "BZR7KGQFWK"
    },
    "android": {
      "package": "com.aweperi.bookloop",
      "adaptiveIcon": {
        "backgroundColor": "#FFF8F0",
        "foregroundImage": "./assets/images/adaptive-icon.png"
      },
      "permissions": [
        "CAMERA",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow BookLoop to access your camera to scan ISBN barcodes."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#E87446",
          "dark": {
            "backgroundColor": "#E87446"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#D97941",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow BookLoop to use Face ID to sign you in securely."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "BookLoop uses your location to show books shared by readers near you."
        }
      ],
      "expo-web-browser",
      "expo-secure-store",
      "expo-font",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "15.5"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e32353db-7f81-4c0c-8823-ddf9d84cff5d"
      }
    },
    "owner": "aweperi"
  }
}
